{
  "name": "ssh-config",
  "description": "SSH config parser and stringifier",
  "version": "5.2.1",
  "author": "Chen Yangjian (https://www.cyj.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyjake/ssh-config.git"
  },
  "type": "module",
  "types": "./lib/ssh-config.d.ts",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-package-metadata.cjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --experimental-transform-types --test test/unit/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines=90 node --experimental-transform-types --test test/unit/*.test.ts",
    "test:legacy": "node --experimental-transform-types --test test/legacy/*.test.ts",
    "test:legacy:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines=90 node --experimental-transform-types --test test/legacy/*.test.ts",
    "test:exports": "node test/package-exports.cjs",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "main": "dist/ssh-config.js",
  "exports": {
    ".": {
      "types": "./lib/ssh-config.d.ts",
      "import": "./lib/ssh-config.js",
      "require": "./dist/ssh-config.js"
    }
  },
  "engines": {
    "node": ">= 14.13.1"
  },
  "license": "MIT"
}
