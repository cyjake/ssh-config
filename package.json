{
  "name": "ssh-config",
  "description": "SSH config parser and stringifier",
  "version": "5.2.0",
  "author": "Chen Yangjian (https://www.cyj.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyjake/ssh-config.git"
  },
  "types": "./lib/ssh-config.d.ts",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "heredoc": "^1.3.1",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint": "eslint --ext ts .",
    "lint:fix": "eslint --ext ts --fix .",
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-package-metadata.cjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "mocha --spec test/unit/**/*.test.ts --node-option=experimental-transform-types",
    "test:coverage": "nyc mocha --spec test/unit/**/*.test.ts --node-option=experimental-transform-types && nyc report --reporter=lcov",
    "test:legacy": "TS_NODE_PROJECT=./tsconfig.cjs.json mocha --spec test/legacy/**/*.test.ts",
    "test:legacy:coverage": "TS_NODE_PROJECT=./tsconfig.cjs.json nyc mocha --spec test/legacy/**/*.test.ts && nyc report --reporter=lcov",
    "test:exports": "node test/package-exports.cjs",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "main": "dist/ssh-config.js",
  "exports": {
    ".": {
      "types": "./lib/ssh-config.d.ts",
      "import": "./lib/ssh-config.js",
      "require": "./dist/ssh-config.js"
    }
  },
  "engines": {
    "node": ">= 14.13.1"
  },
  "license": "MIT"
}
